/* Encrypted Journal TUI - app-wide styles */

Screen {
    align: center middle;
}

#unlock-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#unlock-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    padding-bottom: 1;
}

#unlock-prompt {
    padding-bottom: 1;
}

#password-input {
    margin-bottom: 1;
}

#remember-checkbox {
    margin-bottom: 1;
}

#unlock-error {
    color: $error;
    height: auto;
    min-height: 1;
    padding-bottom: 1;
}

#unlock-submit {
    width: 100%;
}

#unlocked-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $success;
    background: $panel;
}

#unlocked-message {
    text-style: bold;
    width: 100%;
    content-align: center middle;
}

#unlocked-submessage {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}
