/* Encrypted Journal TUI - app-wide styles */

Screen {
    align: center middle;
}

#unlock-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#unlock-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    padding-bottom: 1;
}

#unlock-prompt {
    padding-bottom: 1;
}

#password-input {
    margin-bottom: 1;
}

#remember-checkbox {
    margin-bottom: 1;
}

#unlock-error {
    color: $error;
    height: auto;
    min-height: 1;
    padding-bottom: 1;
}

#unlock-submit {
    width: 100%;
}

#unlocked-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $success;
    background: $panel;
}

#unlocked-message {
    text-style: bold;
    width: 100%;
    content-align: center middle;
}

#unlocked-submessage {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

#entrylist-dialog {
    width: 80%;
    height: 80%;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#entrylist-days-status {
    width: 100%;
    padding-bottom: 1;
    color: $text-muted;
}

#entrylist-tree {
    height: 1fr;
    border: round $primary-background;
}

#entrylist-message {
    color: $warning;
    height: auto;
    min-height: 1;
    padding-top: 1;
}

.hidden {
    display: none;
}

#entryview-dialog {
    width: 80%;
    height: 80%;
    padding: 1 2;
    border: round $success;
    background: $panel;
}

#entryview-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    padding-bottom: 1;
}

#entryview-editor {
    height: 1fr;
}

#entryview-date-label {
    color: $text-muted;
}

#entryview-date-input {
    margin-bottom: 1;
}

#entryview-body {
    height: 1fr;
    border: round $primary-background;
}

#entryview-message {
    color: $warning;
    height: auto;
    min-height: 1;
    padding-top: 1;
}

#entryview-reprompt {
    height: auto;
}

#entryview-reprompt-message {
    color: $warning;
    height: auto;
    min-height: 1;
    padding-bottom: 1;
}

#entryview-reprompt-password {
    margin-bottom: 1;
}

#entryview-reprompt-submit {
    width: 100%;
}

#delete-confirm-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $panel;
}

#delete-confirm-message {
    width: 100%;
    content-align: center middle;
    padding-bottom: 1;
}

#delete-confirm-buttons {
    height: auto;
    align: center middle;
}

#delete-confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

#delete-confirm-error-message {
    color: $error;
    width: 100%;
    content-align: center middle;
    padding-bottom: 1;
}

#delete-confirm-ok {
    width: 100%;
}
